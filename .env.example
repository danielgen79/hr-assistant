# Variables del HR Assistant. Copia este archivo a .env; nunca subas secretos.

# Modelo: fake (simulado) o gateway (Cloudflare Workers AI por AI Gateway)
MODEL_PROVIDER=fake
CF_ACCOUNT_ID=
CF_GATEWAY_ID=default
# Secreto: se define en el entorno, nunca en este archivo
CF_API_TOKEN=

# Costos
MODEL_SMALL=@cf/meta/llama-3.1-8b-instruct-fast
MODEL_LARGE=@cf/meta/llama-3.3-70b-instruct-fp8-fast
ROUTING=true
ROUTER_MAX_CHARS=80
HISTORY_WINDOW=6
MODEL_MAX_TOKENS=300
MODEL_TEMPERATURE=0
CACHE_TTL_SECONDS=0
PRICES_PATH=data/model_prices.json

# Seguridad. No existe un modo abierto: sin clave valida, la API responde 401.
# development solo local; production aplica las reglas de compliance al arrancar.
ENVIRONMENT=development
RATE_LIMIT_PER_MINUTE=30
# Clave de EJEMPLO, publica y ficticia, solo para probar en local.
# NUNCA la uses en producción: el arranque con ENVIRONMENT=production la rechaza.
API_KEYS=demo:demo-example-key-0000

# Datos sensibles: mask enmascara y sigue; block rechaza con 422. No hay modo apagado.
PII_MODE=mask
MAX_HISTORY_MESSAGES=20
MAX_ANSWER_CHARS=4000

# Agente y API
AGENT_MAX_STEPS=3
MAX_QUESTION_CHARS=2000
EMPLOYEES_PATH=data/employees.json

# Observabilidad
SERVICE_NAME=hr-assistant
SLO_P95_MS=2000
LANGSMITH_TRACING=false
# Secreto: se define en el entorno, nunca en este archivo
LANGSMITH_API_KEY=
HIDE_INPUTS=true
HIDE_OUTPUTS=true
